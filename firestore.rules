rules_version = '2';

// כללי אבטחה ל-Firestore.
// - קריאה: פתוחה לכולם (זה מילון ציבורי).
// - יצירה: פתוחה לכולם (גם ללא התחברות - "אורח"), אבל רק עם השדות הנכונים
//   ובברירת מחדל confirm=0 (ממתין לאישור ב-panel הניהול). אם המשתמש מחובר
//   (Google Sign-In) אפשר גם לצרף שדה uid - רק אם הוא שווה בדיוק ל-uid של
//   המשתמש המחובר עצמו (למניעת התחזות למישהו אחר).
// - עדכון: לכל אחד - מותר רק לשדות של דירוג (likes/rating/total_rate).
//          לבעל המילה המחובר (uid תואם) - מותר לערוך name/mean/asco, אבל
//          זה תמיד מאפס את confirm בחזרה ל-0 (חוזר לתור האישור של המנהל).
//          למנהל המחובר (Firebase Auth, אימייל קבוע) - מותר הכול, כולל
//          אישור/דחיית מילים ממתינות דרך admin.html.
// - מחיקה: מותרת למנהל המחובר, וגם לבעל המילה המחובר (uid תואם) על המילה
//          שלו בלבד.
//
// לפני production אמיתי כדאי לשקול הגבלת קצב (App Check / Cloud Functions),
// אבל לפרויקט אישי כזה הכללים האלה סבירים כברירת מחדל.
//
// - settings/{settingId}: הגדרות כלליות (כרגע: מחיר קובץ ה-PDF) - קריאה
//   פתוחה, כתיבה רק למנהל.
// - leads/{leadId}: פניות התעניינות מדף הנחיתה של קובץ ה-PDF - יצירה פתוחה
//   (עם ולידציה), קריאה/עדכון/מחיקה רק למנהל.

function isAdmin() {
  return request.auth != null && request.auth.token.email == 'yakir.mos@gmail.com';
}

function isOwner(data) {
  return request.auth != null && data.uid is string && data.uid == request.auth.uid;
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /words/{wordId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(
                        ['name','mean','asco','username','confirm','likes','rating','total_rate','rand']
                      )
                    && request.resource.data.confirm == 0
                    && request.resource.data.likes == 0
                    && request.resource.data.total_rate == 0
                    && request.resource.data.name is string  && request.resource.data.name.size() < 255
                    && request.resource.data.mean is string  && request.resource.data.mean.size() < 255
                    && request.resource.data.asco is string  && request.resource.data.asco.size() < 2000
                    && request.resource.data.username is string && request.resource.data.username.size() < 255
                    && (!('uid' in request.resource.data)
                        || (request.auth != null && request.resource.data.uid == request.auth.uid));

      allow update: if isAdmin()
                    || request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['likes','rating','total_rate'])
                    || (isOwner(resource.data)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','mean','asco','confirm'])
                        && request.resource.data.confirm == 0
                        && request.resource.data.name is string  && request.resource.data.name.size() < 255
                        && request.resource.data.mean is string  && request.resource.data.mean.size() < 255
                        && request.resource.data.asco is string  && request.resource.data.asco.size() < 2000);

      allow delete: if isAdmin() || isOwner(resource.data);
    }

    // settings/{settingId} - הגדרות כלליות של האתר (למשל מחיר קובץ ה-PDF).
    // קריאה פתוחה לכולם (דף הנחיתה צריך להציג את המחיר לכל מבקר), אבל
    // כתיבה/עדכון מותרים רק למנהל המחובר - דרך פאנל הניהול.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // leads/{leadId} - פניות "מעוניין/ת לקנות" מדף הנחיתה של קובץ ה-PDF.
    // יצירה פתוחה לכולם (גם ללא התחברות), אבל רק עם השדות הנכונים ובגדלים
    // סבירים - כדי למנוע ספאם/הצפה. קריאה/עדכון/מחיקה רק למנהל המחובר,
    // כדי ששום גולש לא יוכל לראות פרטי קשר של גולשים אחרים.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name','contact','createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
                    && request.resource.data.contact is string && request.resource.data.contact.size() > 0 && request.resource.data.contact.size() < 150
                    && request.resource.data.createdAt is timestamp;

      allow read, update, delete: if isAdmin();
    }
  }
}
